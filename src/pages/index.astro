			{ tag: "AGENCY", text: "Autonomous ad asset optimization complete: click vector alignment stable." }
		]
	};

	let consoleInterval: number;
	
	function startConsoleLogs(brand: 'core' | 'labs' | 'agency') {
		const output = document.getElementById('console-output');
		if (!output) return;
		
		clearInterval(consoleInterval);
		output.innerHTML = '';
		
		const currentLogs = logs[brand];
		let index = 0;
		
		function addLogLine() {
			if (!output) return;
			const log = currentLogs[index % currentLogs.length];
			const date = new Date();
			const timeStr = date.toISOString().slice(11, 19);
			
			const line = document.createElement('div');
			line.className = 'log-line';
			line.innerHTML = `
				<span class="log-time">[${timeStr}]</span>
				<span class="log-tag tag-${brand}">[${log.tag}]</span>
				<span class="log-text">${log.text}</span>
			`;
			
			output.appendChild(line);
			output.scrollTop = output.scrollHeight;
			
			index++;
		}
		
		// Run initial few lines immediately
		for (let i = 0; i < 3; i++) {
			addLogLine();
		}
		
		consoleInterval = setInterval(addLogLine, 3000);
	}

	// Listen to brand switches
	window.addEventListener('brand-change', (e: any) => {
		const brand = e.detail.brand;
		startConsoleLogs(brand);
	});

	// Support split section triggers to update the brand switcher
	const splitColTriggers = document.querySelectorAll('[data-trigger-brand]');
	splitColTriggers.forEach(trigger => {
		trigger.addEventListener('click', (e) => {
			const target = e.currentTarget as HTMLElement;
			const brand = target.dataset.triggerBrand;
			
			const switcherBtn = document.querySelector(`.switcher-btn[data-brand="${brand}"]`) as HTMLElement;
			if (switcherBtn) {
				switcherBtn.click();
				// Smooth scroll to top of section or page to show changes
				window.scrollTo({ top: 0, behavior: 'smooth' });
			}
		});
	});

