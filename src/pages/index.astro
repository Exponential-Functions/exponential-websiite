---
import Layout from '../layouts/Layout.astro';
import BrandSwitcher from '../components/BrandSwitcher.astro';
import NeuralBackground from '../components/NeuralBackground.astro';
import MetricCard from '../components/MetricCard.astro';
import IndustrySolutions from '../components/IndustrySolutions.astro';
import NvidiaDgxVisualizer from '../components/NvidiaDgxVisualizer.astro';
import AgentWorkflowVisual from '../components/AgentWorkflowVisual.astro';
import EcosystemCanvas from '../components/EcosystemCanvas.astro';
import HeroRadarHud from '../components/HeroRadarHud.astro';
import SideNavIndicator from '../components/SideNavIndicator.astro';
---

<Layout>
	<main class="page-container">
		<NeuralBackground />
		<SideNavIndicator />
		
		<!-- Top Navigation Bar -->
		<header class="header">
			<div class="header-inner container">
				<a href="#" class="logo">
					<img src="/expo-logo.png" alt="Exponential Logo" class="header-logo-img" />
					<span class="logo-text">EXPONENTI<span class="logo-accent">Λ</span>L</span>
				</a>
				
				<BrandSwitcher />
				
				<nav class="nav-desktop">
					<a href="#connect" class="nav-link contact-btn">Briefing</a>
				</nav>

				<button class="mobile-menu-trigger" id="menu-trigger" aria-label="Toggle Menu">
					<span class="hamburger-line"></span>
					<span class="hamburger-line"></span>
				</button>
			</div>
		</header>

		<!-- Mobile Full-screen Navigation Menu Overlay -->
		<div id="mobile-menu" class="mobile-menu-overlay">
			<nav class="mobile-nav">
				<a href="#connect" class="mobile-nav-link mobile-contact-btn">Briefing</a>
			</nav>
		</div>

		<!-- Hero Section -->
		<section id="hero" class="hero-section container">
			<div class="hero-content">
				<!-- Core Mode Hero Content -->
				<div class="brand-show-core">
					<h1 class="hero-title">
						Engineered for High-Stakes Enterprises. <span class="italic-serif">Proven Across Industries.</span>
					</h1>
					<p class="hero-subtitle">
						From real-time automated infrastructure to domain-specific AI integrations, our battle-tested engineering team converts complex technical challenges into scalable, high-yield digital platforms.
					</p>
				</div>

				<!-- Labs Mode Hero Content -->
				<div class="brand-show-labs">
					<div class="hero-meta font-mono" style="color: var(--accent);">EXPONENTIAL LABS // ADVANCED RESEARCH & BENCHMARKS</div>
					<h1 class="hero-title">
						Applied Research That <span class="italic-serif">Powers Production Systems</span>.
					</h1>
					<p class="hero-subtitle">
						Our LABS section conducts applied research on local LLM fine-tuning, NVIDIA DGX Spark clusters, Hermes agent harnesses, and MCP protocol workflows that feed directly into enterprise CORE solutions.
					</p>
				</div>

				<!-- Agency Mode Hero Content -->
				<div class="brand-show-agency">
					<div class="hero-meta font-mono" style="color: var(--accent);">EXPONENTIAL MARKETING // SYNTHETIC GROWTH</div>
					<h1 class="hero-title">
						Outreach & growth for <span class="italic-serif">hyper-scale expansion</span>.
					</h1>
					<p class="hero-subtitle">
						Delivering customer retention strategies and outreach growth engines through targeted marketing agency initiatives, integrated with Email & WhatsApp communication channels.
					</p>
				</div>

				<div class="hero-actions">
					<a href="#connect" class="btn btn-primary">
						<span>Initiate Technical Brief</span>
						<svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
							<path d="M2.5 9.5L9.5 2.5M9.5 2.5H4M9.5 2.5V8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
						</svg>
					</a>
					<a href="#ecosystem" class="btn btn-secondary">
						<span>Explore Ecosystem</span>
					</a>
				</div>

				<!-- Interactive Hero Radar Matrix HUD -->
				<HeroRadarHud />
			</div>
		</section>

		<!-- Ecosystem Interlinking Visual Canvas Section (Interlinks all 3 modes together) -->
		<section id="ecosystem" class="specs-section container">
			<EcosystemCanvas />
		</section>

		<!-- CORE Section: Industry Solutions (Visible ONLY in CORE mode) -->
		<div class="brand-show-core">
			<section id="solutions" class="specs-section container">
				<div class="section-header">
					<div class="font-mono section-label">CORE // PROVEN ENTERPRISE SOLUTIONS</div>
					<h2 class="section-title">Engineered for Scale. Proven in Production.</h2>
					<p class="hero-subtitle" style="margin-top: 1rem; margin-bottom: 0;">
						We combine deep software architecture with domain-specific AI capabilities to build mission-critical enterprise platforms that eliminate operational friction and accelerate growth.
					</p>
				</div>

				<IndustrySolutions />
			</section>
		</div>

		<!-- LABS Section: Research & Experimentation (Visible ONLY in LABS mode) -->
		<div class="brand-show-labs">
			<section id="research" class="specs-section container">
				<div class="section-header">
					<div class="font-mono section-label" style="color: #0df2a5;">LABS // ADVANCED RESEARCH</div>
					<h2 class="section-title">Applied Research Feeding Directly Into CORE</h2>
					<p class="hero-subtitle" style="margin-top: 1rem; margin-bottom: 0;">
						Our LABS section focuses on breakthrough hardware fine-tuning and agentic workflows that power our enterprise implementations.
					</p>
				</div>

				<!-- NVIDIA DGX Spark Visual Showcase (Green Theme & Magical Hover Gallery) -->
				<NvidiaDgxVisualizer />

				<!-- AI Agents & Intelligent Workflows (Hermes & MCP Protocol) -->
				<AgentWorkflowVisual />
			</section>
		</div>

		<!-- AGENCY Section: Growth Engines & Gateways (Visible ONLY in AGENCY mode) -->
		<div class="brand-show-agency">
			<section id="agency-growth" class="specs-section container">
				<div class="section-header">
					<div class="font-mono section-label" style="color: var(--accent);">AGENCY // SYNTHETIC GROWTH & OMNICHANNEL</div>
					<h2 class="section-title">Outreach & Engagement Scaling Engines</h2>
					<p class="hero-subtitle" style="margin-top: 1rem; margin-bottom: 0;">
						Integrating high-throughput Email & WhatsApp gateways, behavioral retention scoring, and synthetic marketing campaign automation.
					</p>
				</div>

				<div class="agency-features-grid" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; margin-top: 2rem;">
					<div style="border-top: 1px solid var(--border-color); padding-top: 1.5rem;">
						<div class="font-mono" style="font-size: 0.72rem; color: var(--accent); margin-bottom: 0.5rem;">01 / GATEWAYS</div>
						<h3 style="font-size: 1.25rem; font-weight: 500; margin-bottom: 0.5rem; color: var(--text-primary);">Email & WhatsApp Dispatch</h3>
						<p style="font-size: 0.85rem; color: var(--text-secondary); line-height: 1.6; font-weight: 300;">Sub-50ms transactional message routing with verified recipient tracking and automated multi-channel fallback.</p>
					</div>
					<div style="border-top: 1px solid var(--border-color); padding-top: 1.5rem;">
						<div class="font-mono" style="font-size: 0.72rem; color: var(--accent); margin-bottom: 0.5rem;">02 / CAMPAIGNS</div>
						<h3 style="font-size: 1.25rem; font-weight: 500; margin-bottom: 0.5rem; color: var(--text-primary);">Synthetic Campaign Engines</h3>
						<p style="font-size: 0.85rem; color: var(--text-secondary); line-height: 1.6; font-weight: 300;">Real-time asset variant generation and predictive copy alignment optimizing conversion funnels autonomously.</p>
					</div>
					<div style="border-top: 1px solid var(--border-color); padding-top: 1.5rem;">
						<div class="font-mono" style="font-size: 0.72rem; color: var(--accent); margin-bottom: 0.5rem;">03 / RETENTION</div>
						<h3 style="font-size: 1.25rem; font-weight: 500; margin-bottom: 0.5rem; color: var(--text-primary);">Behavioral Retention Scoring</h3>
						<p style="font-size: 0.85rem; color: var(--text-secondary); line-height: 1.6; font-weight: 300;">Latent customer propensity analysis detecting churn signals and triggering hyper-personalized re-engagement loops.</p>
					</div>
				</div>
			</section>
		</div>

		<!-- Architecture Grid Section -->
		<section id="architecture" class="specs-section container">
			<div class="section-header">
				<div class="font-mono section-label">TECHNICAL DATA</div>
				<h2 class="section-title">System Characteristics</h2>
			</div>

			<!-- Core Cards Grid -->
			<div class="brand-show-core">
				<div class="specs-grid">
					<MetricCard 
						label="CORE_METRIC_01"
						value="99.98%"
						title="Private Stack Observability"
						description="Continuous signal analytics tracking model drift and latency anomalies across custom container environments."
						status="OPTIMAL"
					/>
					<MetricCard 
						label="CORE_METRIC_02"
						value="14.2ms"
						title="Agentic Workflow Dispatch"
						description="Low-latency routing framework syncing cognitive cloud systems with client datastores."
						status="STABLE"
					/>
					<MetricCard 
						label="CORE_METRIC_03"
						value="4.2 PetaFLOPs"
						title="Neural Infrastructure Capacity"
						description="Dedicated compute nodes supporting secure client local model hosting and inference pipelines."
						status="MAXIMUM"
					/>
				</div>
			</div>

			<!-- Labs Cards Grid -->
			<div class="brand-show-labs">
				<div class="specs-grid">
					<MetricCard 
						label="LABS_METRIC_01"
						value="1.8ms"
						title="Local Inference Token Latency"
						description="Highly optimized custom quantization kernels running on modern local metal architecture."
						status="ACTIVE"
					/>
					<MetricCard 
						label="LABS_METRIC_02"
						value="405B"
						title="Sovereign Parameter Tuning"
						description="Full-parameter alignment and instruction tuning on custom enterprise cognitive models."
						status="TRAINING"
					/>
					<MetricCard 
						label="LABS_METRIC_03"
						value="100% Private"
						title="Air-gapped Intranets"
						description="Zero data egress private intelligence networks running offline inference nodes."
						status="SECURE"
					/>
				</div>
			</div>

			<!-- Agency Cards Grid -->
			<div class="brand-show-agency">
				<div class="specs-grid">
					<MetricCard 
						label="AGENCY_METRIC_01"
						value="8.4x"
						title="Synthetic Conversion Velocity"
						description="Dynamic agent-driven asset generation testing variations across cohort channels in real time."
						status="LIVE"
					/>
					<MetricCard 
						label="AGENCY_METRIC_02"
						value="2.4M/sec"
						title="Signal Analytics Flow"
						description="Real-time ingestion of social, news, and market data feeding autonomous operations."
						status="SYNCHRONIZED"
					/>
					<MetricCard 
						label="AGENCY_METRIC_03"
						value="0ms Lag"
						title="Intelligent Automation"
						description="Instantaneous content translation and personalization scaling campaign vectors globally."
						status="AUTONOMOUS"
					/>
				</div>
			</div>
		</section>

		<!-- System Topologies & Blueprint Section -->
		<section id="topologies" class="topology-section container">
			<div class="section-header">
				<div class="font-mono section-label">SYSTEMS BLUEPRINT</div>
				<h2 class="section-title">Cognitive Topologies</h2>
			</div>

			<div class="topology-layout">
				<!-- Left Sidebar: Domain Selector -->
				<div class="topology-selector">
					<button class="topology-tab active" data-topology="cloud">
						<span class="font-mono tab-num">01</span>
						<span class="tab-title">Decentralized Synaptic Cloud</span>
						<span class="font-mono tab-sub">COGNITIVE_CLOUD_TOPOLOGIES</span>
					</button>
					<button class="topology-tab" data-topology="agents">
						<span class="font-mono tab-num">02</span>
						<span class="tab-title">Agentic Orchestration Graphs</span>
						<span class="font-mono tab-sub">AGENTIC_STATE_MACHINES</span>
					</button>
					<button class="topology-tab" data-topology="llms">
						<span class="font-mono tab-num">03</span>
						<span class="tab-title">Sovereign Tensor Arrays</span>
						<span class="font-mono tab-sub">LOCAL_INFERENCE_CORES</span>
					</button>
					<button class="topology-tab" data-topology="infra">
						<span class="font-mono tab-num">04</span>
						<span class="tab-title">Neural Metal Provisioning</span>
						<span class="font-mono tab-sub">HYPERVISOR_PROVISIONING_METALS</span>
					</button>
					<button class="topology-tab" data-topology="observability">
						<span class="font-mono tab-num">05</span>
						<span class="tab-title">Entropy & Drift Observability</span>
						<span class="font-mono tab-sub">LATTICE_PULSE_AUDITING</span>
					</button>
					<button class="topology-tab" data-topology="analytics">
						<span class="font-mono tab-num">06</span>
						<span class="tab-title">Signal Synthesis Engines</span>
						<span class="font-mono tab-sub">LATENT_VECTOR_EXTRACTION</span>
					</button>
				</div>

				<!-- Right Panel: Inspector Console -->
				<div class="topology-inspector">
					<div class="inspector-inner">
						<div class="inspector-header">
							<span class="font-mono inspector-label">// TOPOLOGY_INSPECTOR</span>
							<span class="font-mono inspector-status" id="inspector-sync-status">SYNCED</span>
						</div>
						
						<div class="inspector-content">
							<div class="inspector-details">
								<h3 class="inspector-title" id="ins-title">Decentralized Synaptic Cloud</h3>
								<p class="inspector-desc" id="ins-desc">
									Sovereign compute fabrics bridging local node arrays with distributed edge nodes, eliminating egress overhead.
								</p>
								
								<div class="inspector-metrics">
									<div class="metric-item">
										<span class="font-mono metric-label">LATENCY_LIMIT</span>
										<span class="metric-val" id="ins-m1">&lt; 4.8ms</span>
									</div>
									<div class="metric-item">
										<span class="font-mono metric-label">THROUGHPUT</span>
										<span class="metric-val" id="ins-m2">140 GB/s</span>
									</div>
									<div class="metric-item">
										<span class="font-mono metric-label">COMPLIANCE</span>
										<span class="metric-val" id="ins-m3">ZERO_EGRESS</span>
									</div>
								</div>
							</div>
							
							<div class="inspector-visualization">
								<!-- Interactive Schema SVG -->
								<svg class="blueprint-canvas" width="200" height="200" viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg">
									<g class="blueprint-group">
										<!-- Orbit grids -->
										<circle cx="100" cy="100" r="80" stroke="var(--border-color)" stroke-width="0.75" stroke-dasharray="2 4" />
										<circle cx="100" cy="100" r="50" stroke="var(--border-color)" stroke-width="0.75" />
										
										<!-- Connection lines -->
										<line x1="100" y1="20" x2="100" y2="180" stroke="var(--border-color)" stroke-width="0.75" />
										<line x1="20" y1="100" x2="180" y2="100" stroke="var(--border-color)" stroke-width="0.75" />
										
										<!-- Dynamic active lines -->
										<path id="ins-path-1" d="M100,50 L150,100 L100,150 L50,100 Z" stroke="var(--accent)" stroke-width="1.5" stroke-dasharray="100" stroke-dashoffset="0" />
										
										<!-- Dots representing nodes -->
										<circle id="node-dot-1" cx="100" cy="50" r="4" fill="var(--accent)" />
										<circle id="node-dot-2" cx="150" cy="100" r="4" fill="var(--accent)" />
										<circle id="node-dot-3" cx="100" cy="150" r="4" fill="var(--accent)" />
										<circle id="node-dot-4" cx="50" cy="100" r="4" fill="var(--accent)" />
										<circle cx="100" cy="100" r="6" fill="var(--text-primary)" />
									</g>
								</svg>
								
								<!-- Monospace JSON Config block -->
								<div class="config-block">
									<pre class="font-mono"><code id="ins-code">&#123;
  "topology": "synaptic-cloud",
  "hubs": ["sf-node-01", "tokyo-edge-04"],
  "protocols": ["quic-cognitive"],
  "egress_routing": "zero-overhead"
&#125;</code></pre>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Interactive Console Section -->
		<section id="observability" class="console-section container">
			<div class="console-wrapper">
				<div class="console-header">
					<div class="console-dots">
						<span class="dot-red"></span>
						<span class="dot-yellow"></span>
						<span class="dot-green"></span>
					</div>
					<div class="console-title font-mono">system_observability_console.log</div>
					<div class="console-status font-mono">LIVESTREAM</div>
				</div>
				<div class="console-body">
					<div class="console-lines font-mono" id="console-output">
						<!-- JavaScript will inject log streams here -->
					</div>
				</div>
			</div>
		</section>

		<!-- Sub-Brands Showcase Section -->
		<section class="split-brands-section container">
			<div class="split-grid">
				<div class="split-col labs-col">
					<div class="split-bg-effect"></div>
					<div class="col-content">
						<span class="font-mono col-num">01 / RESEARCH</span>
						<h3 class="col-title">Exponential Labs</h3>
						<p class="col-desc">
							Dedicated to deep-tech artificial intelligence research. We design next-generation agent workflows and local model alignment techniques for sovereign infrastructures.
						</p>
						<button class="col-action-btn font-mono" data-trigger-brand="labs">Initialize Labs View</button>
					</div>
				</div>
				<div class="split-col agency-col">
					<div class="split-bg-effect"></div>
					<div class="col-content">
						<span class="font-mono col-num">02 / APPLICATIONS</span>
						<h3 class="col-title">Exponential Marketing Agency</h3>
						<p class="col-desc">
							Focusing on AI-powered brand growth, signal analytics, and creative automation systems that scale conversions while keeping brand aesthetics premium.
						</p>
						<button class="col-action-btn font-mono" data-trigger-brand="agency">Initialize Agency View</button>
					</div>
				</div>
			</div>
		</section>

		<!-- Contact Section -->
		<section id="connect" class="contact-section container">
			<div class="contact-card">
				<div class="contact-grid">
					<div class="contact-info">
						<div class="font-mono contact-meta">SYSTEM CONNECTION</div>
						<h2 class="contact-title">Initiate a Technical Briefing</h2>
						<p class="contact-desc">
							Let's build secure neural infrastructure tailored to your parameters. Connect with our engineering or creative intelligence systems.
						</p>
						<div class="contact-coords font-mono">
							<p>SF // 37.7749° N, 122.4194° W</p>
							<p>MUMBAI // 19.0760° N, 72.8777° E</p>
							<p>PUNE // 18.5204° N, 73.8567° E</p>
							<p>BLR // 12.9716° N, 77.5946° E</p>
							<p>STOCKHOLM // 59.3293° N, 18.0686° E</p>
						</div>
					</div>
					<div class="contact-form-wrapper">
						<form class="contact-form" id="handshake-form">
							<div class="form-group">
								<label class="font-mono" for="email">IDENTITY / EMAIL</label>
								<input type="email" id="email" required placeholder="name@organization.com" />
							</div>
							<div class="form-group">
								<label class="font-mono" for="stack">OBJECTIVE / INTERFACE TYPE</label>
								<select id="stack">
									<option value="Core Neural Infrastructure & Cognitive Cloud">Core Neural Infrastructure & Cognitive Cloud</option>
									<option value="Labs: Custom Models & Local Inference">Labs: Custom Models & Local Inference</option>
									<option value="Agency: Synthetic Engines & Growth Analytics">Agency: Synthetic Engines & Growth Analytics</option>
								</select>
							</div>
							<div class="form-group">
								<label class="font-mono" for="note">BRIEFING PARAMETERS</label>
								<textarea id="note" rows="3" placeholder="Outline model requirements, compliance limits, or creative goals..."></textarea>
							</div>
							<button type="submit" class="btn btn-primary form-submit">
								<span>Request Handshake</span>
								<svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
									<path d="M2.5 9.5L9.5 2.5M9.5 2.5H4M9.5 2.5V8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
								</svg>
							</button>
						</form>
					</div>
				</div>
			</div>
		</section>

		<!-- Footer -->
		<footer class="footer">
			<div class="footer-inner container">
				<div class="footer-brand">
					<h3 class="footer-cta-title">Stay close to <span class="italic-serif">Exponential Functions</span></h3>
					<p class="footer-brand-tagline">Updates on neural infrastructure, agentic workflows, and what's provisioning.</p>
					
					<form class="footer-subscribe-form" id="subscribe-form">
						<input type="email" placeholder="Enter your email" required class="subscribe-input" id="subscribe-email" />
						<button type="submit" class="subscribe-btn">Subscribe</button>
					</form>
				</div>
				
				<div class="footer-links-grid">
					<div class="footer-links-col">
						<span class="font-mono footer-col-title">SYSTEM</span>
						<a href="#architecture">Specifications</a>
						<a href="#observability">Console Log</a>
						<a href="#connect">Handshake</a>
					</div>
					<div class="footer-links-col">
						<span class="font-mono footer-col-title">GLOBAL HUBS</span>
						<a href="#connect">San Francisco</a>
						<a href="#connect">Mumbai AI Hub</a>
						<a href="#connect">Pune AI Company</a>
						<a href="#connect">Bengaluru AI Startups</a>
						<a href="#connect">Stockholm Research</a>
					</div>
					<div class="footer-links-col">
						<span class="font-mono footer-col-title">LEGAL & GOVERNANCE</span>
						<a href="#">Terms of Protocol</a>
						<a href="#">Privacy Schema</a>
					</div>
				</div>
			</div>
			
			<div class="footer-bottom container">
				<p class="copyright">Exponential Functions &copy; {new Date().getFullYear()}</p>
				
				<div class="footer-socials">
					<a href="#" aria-label="GitHub">GH</a>
					<a href="#" aria-label="Hugging Face">HF</a>
					<a href="#" aria-label="Twitter / X">X</a>
					<a href="#" aria-label="Discord">DC</a>
				</div>
			</div>

			<div class="footer-huge-bg-text">
				EXPONENTIΛL
			</div>
		</footer>
	</main>
</Layout>

<style>
	/* Dynamic brand views display logic */
	.brand-show-core, .brand-show-labs, .brand-show-agency {
		display: none;
	}

	html.brand-core .brand-show-core {
		display: block;
		animation: fadeInBrand 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
	}
	html.brand-labs .brand-show-labs {
		display: block;
		animation: fadeInBrand 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
	}
	html.brand-agency .brand-show-agency {
		display: block;
		animation: fadeInBrand 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
	}

	@keyframes fadeInBrand {
		from {
			opacity: 0;
			transform: translateY(8px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.page-container {
		position: relative;
		min-height: 100vh;
		width: 100%;
		overflow: hidden;
		display: flex;
		flex-direction: column;
	}

	/* Header Styling */
	.header {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 50;
		border-bottom: 1px solid var(--border-color);
		background: color-mix(in srgb, var(--bg-primary) 70%, transparent);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		transition: border-color 0.8s ease, background-color 0.8s ease;
	}

	.header-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		height: 72px;
	}

	.logo {
		font-family: 'Plus Jakarta Sans', sans-serif;
		font-weight: 600;
		font-size: 0.95rem;
		letter-spacing: 0.25em;
		text-decoration: none;
		color: var(--text-primary);
		display: flex;
		align-items: center;
		gap: 12px;
		transition: color 0.8s ease;
	}

	.header-logo-img {
		height: 32px;
		width: auto;
		display: block;
		object-fit: contain;
		filter: drop-shadow(0 0 10px rgba(255, 255, 255, 0.15));
		transition: transform 0.3s ease;
	}

	.logo:hover .header-logo-img {
		transform: scale(1.06);
	}

	.logo-accent {
		color: var(--accent);
		transition: color 0.8s ease;
	}

	.nav-desktop {
		display: flex;
		align-items: center;
		gap: 2rem;
	}

	.nav-link {
		text-decoration: none;
		font-size: 0.8rem;
		font-weight: 500;
		color: var(--text-secondary);
		transition: color 0.3s ease;
		display: flex;
		align-items: center;
		gap: 4px;
	}

	.nav-num {
		color: var(--accent);
		font-size: 0.75rem;
		font-family: 'JetBrains Mono', monospace;
	}

	.nav-link:hover {
		color: var(--text-primary);
	}

	.contact-btn {
		background: var(--text-primary);
		color: var(--bg-primary);
		padding: 6px 14px;
		border-radius: 99px;
		font-weight: 600;
		transition: transform 0.3s ease, background-color 0.8s ease, color 0.8s ease;
	}

	.contact-btn:hover {
		transform: translateY(-1px);
		color: var(--bg-primary);
	}

	.mobile-menu-trigger {
		display: none;
		flex-direction: column;
		justify-content: center;
		gap: 6px;
		width: 30px;
		height: 30px;
		background: transparent;
		border: none;
		cursor: pointer;
		padding: 0;
		z-index: 110;
	}

	.hamburger-line {
		width: 22px;
		height: 1.5px;
		background: var(--text-primary);
		transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), background-color 0.8s ease;
	}

	.mobile-menu-trigger.active .hamburger-line:nth-child(1) {
		transform: translateY(3.75px) rotate(45deg);
	}

	.mobile-menu-trigger.active .hamburger-line:nth-child(2) {
		transform: translateY(-3.75px) rotate(-45deg);
	}

	.mobile-menu-overlay {
		position: fixed;
		inset: 0;
		background: var(--bg-primary);
		z-index: 105;
		display: flex;
		justify-content: center;
		align-items: center;
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1), background-color 0.8s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.mobile-menu-overlay.active {
		opacity: 1;
		pointer-events: auto;
	}

	.mobile-nav {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 2.5rem;
		text-align: center;
		width: 100%;
		padding: 2rem;
	}

	.mobile-nav-link {
		text-decoration: none;
		font-size: 1.5rem;
		font-family: 'Plus Jakarta Sans', sans-serif;
		font-weight: 500;
		color: var(--text-primary);
		display: flex;
		align-items: center;
		gap: 8px;
		transition: transform 0.3s ease, color 0.8s ease;
	}

	.mobile-nav-link:hover {
		transform: translateY(-2px);
	}

	.mobile-contact-btn {
		background: var(--text-primary);
		color: var(--bg-primary);
		padding: 10px 24px;
		border-radius: 99px;
		font-size: 1.1rem;
		font-weight: 600;
		transition: background-color 0.8s ease, color 0.8s ease;
	}

	/* Hero Section */
	.hero-section {
		padding-top: 180px;
		padding-bottom: 100px;
		position: relative;
		z-index: 5;
		display: flex;
		align-items: center;
		min-height: 85vh;
	}

	.hero-content {
		max-width: 850px;
	}

	.hero-meta {
		font-size: 0.8rem;
		color: var(--text-secondary);
		margin-bottom: 1.5rem;
		letter-spacing: 0.15em;
		display: inline-block;
		transition: color 0.8s ease;
	}

	.hero-title {
		font-size: 4.8rem;
		margin-bottom: 2rem;
		color: var(--text-primary);
		transition: color 0.8s ease;
	}

	.italic-serif {
		font-family: 'Instrument Serif', Georgia, serif;
		font-style: italic;
	}

	.hero-subtitle {
		font-size: 1.2rem;
		line-height: 1.7;
		color: var(--text-secondary);
		margin-bottom: 3rem;
		max-width: 680px;
		font-weight: 300;
		transition: color 0.8s ease;
	}

	.hero-actions {
		display: flex;
		align-items: center;
		gap: 1.5rem;
	}

	/* Buttons styling */
	.btn {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 14px 28px;
		border-radius: 99px;
		font-family: 'Plus Jakarta Sans', sans-serif;
		font-size: 0.85rem;
		font-weight: 600;
		text-decoration: none;
		cursor: pointer;
		transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.btn-primary {
		background: var(--text-primary);
		color: var(--bg-primary);
		border: 1px solid var(--text-primary);
	}

	.btn-primary:hover {
		transform: translateY(-2px);
		box-shadow: 0 10px 25px rgba(var(--accent-rgb), 0.15);
	}

	.btn-secondary {
		background: transparent;
		color: var(--text-primary);
		border: 1px solid var(--border-color);
	}

	.btn-secondary:hover {
		border-color: var(--text-primary);
		background: rgba(var(--accent-rgb), 0.03);
	}

	/* Specs Section */
	.specs-section {
		padding: 100px 0;
		position: relative;
		z-index: 5;
		border-top: 1px solid var(--border-color);
		transition: border-color 0.8s ease;
	}

	.section-header {
		margin-bottom: 4rem;
	}

	.section-label {
		color: var(--text-muted);
		font-size: 0.75rem;
		letter-spacing: 0.1em;
		margin-bottom: 1rem;
	}

	.section-title {
		font-size: 2.75rem;
		color: var(--text-primary);
		transition: color 0.8s ease;
	}

	.specs-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 2rem;
	}

	/* Topology Section Styles */
	.topology-section {
		padding: 100px 0;
		border-top: 1px solid var(--border-color);
		position: relative;
		z-index: 5;
		transition: border-color 0.8s ease;
	}

	.topology-layout {
		display: grid;
		grid-template-columns: 1.1fr 1.9fr;
		gap: 2.5rem;
		margin-top: 2rem;
	}

	.topology-selector {
		display: flex;
		flex-direction: column;
		border: 1px solid var(--border-color);
		background: var(--bg-secondary);
		transition: border-color 0.8s ease, background-color 0.8s ease;
	}

	.topology-tab {
		background: transparent;
		border: none;
		border-bottom: 1px solid var(--border-color);
		padding: 1.5rem;
		text-align: left;
		cursor: pointer;
		display: flex;
		flex-direction: column;
		gap: 6px;
		position: relative;
		transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
		outline: none;
	}

	.topology-tab:last-child {
		border-bottom: none;
	}

	.topology-tab::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0;
		bottom: 0;
		width: 3px;
		background: transparent;
		transition: background-color 0.4s ease;
	}

	.topology-tab:hover {
		background: var(--bg-tertiary);
	}

	.topology-tab.active {
		background: var(--bg-tertiary);
	}

	.topology-tab.active::before {
		background: var(--accent);
	}

	.tab-num {
		font-size: 0.7rem;
		color: var(--accent);
	}

	.tab-title {
		font-family: 'Plus Jakarta Sans', sans-serif;
		font-size: 1.05rem;
		font-weight: 500;
		color: var(--text-primary);
		transition: color 0.8s ease;
	}

	.tab-sub {
		font-size: 0.65rem;
		color: var(--text-muted);
	}

	.topology-inspector {
		border: 1px solid var(--border-color);
		background: var(--bg-secondary);
		padding: 2.5rem;
		position: relative;
		display: flex;
		flex-direction: column;
		transition: border-color 0.8s ease, background-color 0.8s ease;
	}

	.inspector-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		border-bottom: 1px solid var(--border-color);
		padding-bottom: 1rem;
		margin-bottom: 2rem;
		transition: border-color 0.8s ease;
	}

	.inspector-label {
		font-size: 0.75rem;
		color: var(--text-muted);
	}

	.inspector-status {
		font-size: 0.7rem;
		color: var(--accent);
		display: flex;
		align-items: center;
		gap: 6px;
	}

	.inspector-status::before {
		content: '';
		width: 5px;
		height: 5px;
		background: var(--accent);
		border-radius: 50%;
		box-shadow: 0 0 8px var(--accent);
	}

	.inspector-content {
		display: grid;
		grid-template-columns: 1.2fr 1fr;
		gap: 2rem;
		align-items: start;
	}

	.inspector-title {
		font-size: 2.2rem;
		color: var(--text-primary);
		margin-bottom: 1rem;
		transition: color 0.8s ease;
	}

	.inspector-desc {
		font-size: 0.9rem;
		color: var(--text-secondary);
		line-height: 1.6;
		margin-bottom: 2rem;
		font-weight: 300;
		transition: color 0.8s ease;
	}

	.inspector-metrics {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	.metric-item {
		display: flex;
		flex-direction: column;
		gap: 4px;
	}

	.metric-label {
		font-size: 0.65rem;
		color: var(--text-muted);
	}

	.metric-val {
		font-size: 1.15rem;
		color: var(--text-primary);
		font-family: 'Instrument Serif', serif;
		transition: color 0.8s ease;
	}

	.inspector-visualization {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.5rem;
	}

	.blueprint-canvas {
		transition: transform 0.5s ease;
	}

	.blueprint-group {
		transform-origin: 100px 100px;
		animation: blueprintSpin 24s linear infinite;
	}

	#ins-path-1 {
		stroke-dasharray: 12, 6;
		animation: drawTopologyPath 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards, pulsePathFlow 1.5s linear infinite;
	}

	@keyframes drawTopologyPath {
		from {
			opacity: 0;
			stroke-dashoffset: 100;
		}
		to {
			opacity: 1;
			stroke-dashoffset: 0;
		}
	}

	@keyframes pulsePathFlow {
		from {
			stroke-dashoffset: 0;
		}
		to {
			stroke-dashoffset: -36;
		}
	}

	.config-block {
		background: #020203;
		border: 1px solid #1f1f23;
		padding: 1rem;
		width: 100%;
		border-radius: 4px;
		overflow-x: auto;
	}

	.config-block code {
		color: #4ade80;
		font-size: 0.7rem;
		display: block;
		white-space: pre-wrap;
	}

	@keyframes blueprintSpin {
		from { transform: rotate(0deg); }
		to { transform: rotate(360deg); }
	}

	@media (max-width: 1024px) {
		.topology-layout {
			grid-template-columns: 1fr;
		}
		.inspector-content {
			grid-template-columns: 1fr;
			gap: 3rem;
		}
	}

	/* Console Section */
	.console-section {
		padding: 60px 0;
		position: relative;
		z-index: 5;
	}

	.console-wrapper {
		background: #020203;
		border: 1px solid #1f1f23;
		border-radius: 8px;
		overflow: hidden;
		box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4);
	}

	.console-header {
		background: #09090b;
		border-bottom: 1px solid #1f1f23;
		height: 40px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0 1rem;
	}

	.console-dots {
		display: flex;
		gap: 6px;
	}

	.console-dots span {
		width: 10px;
		height: 10px;
		border-radius: 50%;
	}

	.dot-red { background: #ff5f56; }
	.dot-yellow { background: #ffbd2e; }
	.dot-green { background: #27c93f; }

	.console-title {
		color: #71717a;
		font-size: 0.75rem;
	}

	.console-status {
		color: #27c93f;
		font-size: 0.7rem;
		display: flex;
		align-items: center;
		gap: 6px;
	}

	.console-status::before {
		content: '';
		width: 6px;
		height: 6px;
		background: #27c93f;
		border-radius: 50%;
		animation: pulse 1s infinite alternate;
	}

	.console-body {
		padding: 1.5rem;
		height: 240px;
		overflow-y: auto;
		background: #040406;
	}

	.console-lines {
		color: #a1a1aa;
		font-size: 0.75rem;
		line-height: 1.6;
	}

	.log-line {
		margin-bottom: 0.5rem;
		display: flex;
		gap: 12px;
	}

	.log-time {
		color: #52525b;
		user-select: none;
	}

	.log-tag {
		font-weight: 500;
	}
	
	.tag-core { color: #d4d4d8; }
	.tag-labs { color: #58a6ff; }
	.tag-agency { color: #876534; }

	/* Split Brands Section */
	.split-brands-section {
		padding: 100px 0;
		border-top: 1px solid var(--border-color);
		position: relative;
		z-index: 5;
		transition: border-color 0.8s ease;
	}

	.split-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 2.5rem;
	}

	.split-col {
		border: 1px solid var(--border-color);
		background: var(--bg-secondary);
		padding: 4.5rem 3.5rem;
		position: relative;
		overflow: hidden;
		transition: border-color 0.8s ease, background-color 0.8s ease;
	}

	.split-bg-effect {
		position: absolute;
		inset: 0;
		opacity: 0.03;
		background-size: 20px 20px;
		background-image: radial-gradient(circle, var(--text-primary) 1px, transparent 1px);
		pointer-events: none;
	}

	.col-content {
		position: relative;
		z-index: 2;
	}

	.col-num {
		color: var(--accent);
		font-size: 0.75rem;
		margin-bottom: 1.5rem;
		display: block;
	}

	.col-title {
		font-size: 2.25rem;
		color: var(--text-primary);
		margin-bottom: 1rem;
		transition: color 0.8s ease;
	}

	.col-desc {
		font-size: 0.95rem;
		color: var(--text-secondary);
		line-height: 1.6;
		margin-bottom: 2.5rem;
		font-weight: 300;
		transition: color 0.8s ease;
	}

	.col-action-btn {
		background: transparent;
		border: 1px solid var(--border-color);
		color: var(--text-primary);
		padding: 10px 20px;
		font-size: 0.75rem;
		font-weight: 600;
		cursor: pointer;
		border-radius: 4px;
		transition: all 0.3s ease;
	}

	.col-action-btn:hover {
		border-color: var(--text-primary);
		background: var(--bg-tertiary);
	}

	/* Contact Section */
	.contact-section {
		padding: 100px 0;
		position: relative;
		z-index: 5;
	}

	.contact-card {
		background: var(--bg-secondary);
		border: 1px solid var(--border-color);
		padding: 4.5rem;
		position: relative;
		transition: border-color 0.8s ease, background-color 0.8s ease;
	}

	.contact-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 4rem;
	}

	.contact-meta {
		color: var(--text-muted);
		font-size: 0.75rem;
		margin-bottom: 1.5rem;
	}

	.contact-title {
		font-size: 3rem;
		color: var(--text-primary);
		margin-bottom: 1.5rem;
		transition: color 0.8s ease;
	}

	.contact-desc {
		color: var(--text-secondary);
		line-height: 1.6;
		margin-bottom: 3rem;
		font-weight: 300;
		transition: color 0.8s ease;
	}

	.contact-coords {
		color: var(--text-muted);
		font-size: 0.75rem;
		display: flex;
		flex-direction: column;
		gap: 6px;
	}

	.contact-form {
		display: flex;
		flex-direction: column;
		gap: 2rem;
	}

	.form-group {
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	.form-group label {
		font-size: 0.7rem;
		color: var(--text-muted);
	}

	.form-group input, 
	.form-group select, 
	.form-group textarea {
		background: var(--bg-tertiary);
		border: 1px solid var(--border-color);
		padding: 14px;
		color: var(--text-primary);
		font-family: inherit;
		font-size: 0.9rem;
		border-radius: 4px;
		outline: none;
		transition: border-color 0.4s ease, background-color 0.8s ease, color 0.8s ease;
	}

	.form-group input:focus, 
	.form-group select:focus, 
	.form-group textarea:focus {
		border-color: var(--border-focus);
	}

	.form-submit {
		margin-top: 1rem;
		width: max-content;
	}

	.footer {
		border-top: 1px solid var(--border-color);
		background: var(--bg-secondary);
		padding: 6rem 0 0 0;
		position: relative;
		z-index: 5;
		transition: border-color 0.8s ease, background-color 0.8s ease;
		overflow: hidden;
	}

	.footer-inner {
		display: grid;
		grid-template-columns: 1.2fr 1fr;
		gap: 5rem;
		margin-bottom: 5rem;
	}

	.footer-brand {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.footer-cta-title {
		font-size: 2.2rem;
		color: var(--text-primary);
		line-height: 1.2;
		transition: color 0.8s ease;
	}

	.footer-brand-tagline {
		font-size: 0.95rem;
		color: var(--text-secondary);
		max-width: 400px;
		line-height: 1.6;
		font-weight: 300;
	}

	.footer-subscribe-form {
		display: flex;
		align-items: center;
		background: var(--bg-tertiary);
		border: 1px solid var(--border-color);
		border-radius: 99px;
		padding: 4px;
		max-width: 380px;
		width: 100%;
		transition: border-color 0.4s ease;
	}

	.footer-subscribe-form:focus-within {
		border-color: var(--border-focus);
	}

	.subscribe-input {
		background: transparent;
		border: none;
		outline: none;
		padding: 10px 16px;
		color: var(--text-primary);
		font-size: 0.85rem;
		flex-grow: 1;
		width: 100%;
	}

	.subscribe-input::placeholder {
		color: var(--text-muted);
	}

	.subscribe-btn {
		background: var(--text-primary);
		color: var(--bg-primary);
		border: none;
		outline: none;
		padding: 10px 22px;
		border-radius: 99px;
		font-weight: 600;
		font-size: 0.75rem;
		cursor: pointer;
		transition: transform 0.2s ease, background-color 0.8s ease, color 0.8s ease;
	}

	.subscribe-btn:hover {
		transform: scale(1.02);
	}

	.footer-links-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 3rem;
	}

	.footer-col-title {
		color: var(--text-muted);
		font-size: 0.7rem;
		margin-bottom: 1.5rem;
		display: block;
