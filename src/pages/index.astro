---
import Layout from '../layouts/Layout.astro';
import BrandSwitcher from '../components/BrandSwitcher.astro';
import NeuralBackground from '../components/NeuralBackground.astro';
import MetricCard from '../components/MetricCard.astro';
import IndustrySolutions from '../components/IndustrySolutions.astro';
import NvidiaDgxVisualizer from '../components/NvidiaDgxVisualizer.astro';
import AgentWorkflowVisual from '../components/AgentWorkflowVisual.astro';
import EcosystemCanvas from '../components/EcosystemCanvas.astro';
import HeroRadarHud from '../components/HeroRadarHud.astro';
import SideNavIndicator from '../components/SideNavIndicator.astro';
---

<Layout>
	<main class="page-container">
		<NeuralBackground />
		<SideNavIndicator />
		
		<!-- Top Navigation Bar -->
		<header class="header">
			<div class="header-inner container">
				<a href="#" class="logo">
					<img src="/expo-logo.png" alt="Exponential Logo" class="header-logo-img" />
					<span class="logo-text">EXPONENTI<span class="logo-accent">Λ</span>L</span>
				</a>
				
				<BrandSwitcher />
				
				<nav class="nav-desktop">
					<a href="#connect" class="nav-link contact-btn">Briefing</a>
				</nav>

				<button class="mobile-menu-trigger" id="menu-trigger" aria-label="Toggle Menu">
					<span class="hamburger-line"></span>
					<span class="hamburger-line"></span>
				</button>
			</div>
		</header>

		<!-- Mobile Full-screen Navigation Menu Overlay -->
		<div id="mobile-menu" class="mobile-menu-overlay">
			<nav class="mobile-nav">
				<a href="#connect" class="mobile-nav-link mobile-contact-btn">Briefing</a>
			</nav>
		</div>

		<!-- Hero Section -->
		<section id="hero" class="hero-section container">
			<div class="hero-content">
				<!-- Core Mode Hero Content -->
				<div class="brand-show-core">
					<h1 class="hero-title">
						Engineered for High-Stakes Enterprises. <span class="italic-serif"></span>
					</h1>
					<p class="hero-subtitle">
						From real-time automated infrastructure to domain-specific AI integrations, our team can convert complex technical challenges into scalable, high-yield digital platforms.
					</p>
				</div>

				<!-- Labs Mode Hero Content -->
				<div class="brand-show-labs">
					<div class="hero-meta font-mono" style="color: var(--accent);">EXPONENTIAL LABS // ADVANCED RESEARCH & BENCHMARKS</div>
					<h1 class="hero-title">
						Applied Research That <span class="italic-serif">Powers Production Systems</span>.
					</h1>
					<p class="hero-subtitle">
						Our LABS section conducts applied research on local LLM fine-tuning, right now using NVIDIA DGX Spark clusters and MCP protocol workflows that feed directly into enterprise CORE solutions.
					</p>
				</div>

				<!-- Agency Mode Hero Content -->
				<div class="brand-show-agency">
					<div class="hero-meta font-mono" style="color: var(--accent);">EXPONENTIAL MARKETING // SYNTHETIC GROWTH</div>
					<h1 class="hero-title">
						Outreach & growth for <span class="italic-serif">hyper-scale expansion</span>.
					</h1>
					<p class="hero-subtitle">
						Delivering customer retention strategies and outreach growth engines through targeted marketing agency initiatives, integrated with Email & WhatsApp communication channels.
					</p>
				</div>

				<div class="hero-actions">
					<a href="#connect" class="btn btn-primary">
						<span>Initiate Technical Brief</span>
						<svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
							<path d="M2.5 9.5L9.5 2.5M9.5 2.5H4M9.5 2.5V8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
						</svg>
					</a>
					<div class="brand-show-core">
						<a href="#ecosystem" class="btn btn-secondary">
							<span>Explore Ecosystem</span>
						</a>
					</div>
					<div class="brand-show-labs">
						<a href="#research" class="btn btn-secondary">
							<span>Explore Research</span>
						</a>
					</div>
					<div class="brand-show-agency">
						<a href="#agency-growth" class="btn btn-secondary">
							<span>Explore Growth Engines</span>
						</a>
					</div>
				</div>

				<!-- Interactive Hero Radar Matrix HUD -->
				<HeroRadarHud />
			</div>
		</section>

		<!-- Ecosystem Interlinking Visual Canvas Section (Visible ONLY in CORE / Exponential Functions mode) -->
		<div class="brand-show-core">
			<section id="ecosystem" class="specs-section container">
				<EcosystemCanvas />
			</section>
		</div>

		<!-- CORE Section: Industry Solutions (Visible ONLY in CORE mode) -->
		<div class="brand-show-core">
			<section id="solutions" class="specs-section container">
				<div class="section-header">
					<div class="font-mono section-label">CORE // PROVEN ENTERPRISE SOLUTIONS</div>
					<h2 class="section-title">Engineered for Scale. Proven in Production.</h2>
					<p class="hero-subtitle" style="margin-top: 1rem; margin-bottom: 0;">
						We combine deep software architecture with domain-specific AI capabilities to build mission-critical enterprise platforms that eliminate operational friction and accelerate growth.
					</p>
				</div>

				<IndustrySolutions />
			</section>
		</div>

		<!-- LABS Section: Research & Experimentation (Visible ONLY in LABS mode) -->
		<div class="brand-show-labs">
			<section id="research" class="specs-section container">
				<div class="section-header">
					<div class="font-mono section-label" style="color: #0df2a5;">LABS // ADVANCED RESEARCH</div>
					<h2 class="section-title">Applied Research Feeding Directly Into CORE</h2>
					<p class="hero-subtitle" style="margin-top: 1rem; margin-bottom: 0;">
						Our LABS section focuses on fine-tuning local LLMs on specific use-cases and agentic workflows that power our enterprise implementations.
					</p>
				</div>

				<!-- NVIDIA DGX Spark Visual Showcase (Green Theme & Magical Hover Gallery) -->
				<NvidiaDgxVisualizer />

				<!-- AI Agents & Intelligent Workflows (Hermes & MCP Protocol) -->
				<AgentWorkflowVisual />
			</section>
		</div>

		<!-- AGENCY Section: Growth Engines & Gateways (Visible ONLY in AGENCY mode) -->
		<div class="brand-show-agency">
			<section id="agency-growth" class="specs-section container">
				<div class="section-header">
					<div class="font-mono section-label" style="color: var(--accent);">AGENCY // SYNTHETIC GROWTH & OMNICHANNEL</div>
					<h2 class="section-title">Outreach & Engagement Scaling Engines</h2>
					<p class="hero-subtitle" style="margin-top: 1rem; margin-bottom: 0;">
						Integrating high-throughput Email & WhatsApp gateways, behavioral retention scoring, and synthetic marketing campaign automation.
					</p>
				</div>

				<div class="agency-features-grid" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; margin-top: 2rem;">
					<div style="border-top: 1px solid var(--border-color); padding-top: 1.5rem;">
						<div class="font-mono" style="font-size: 0.72rem; color: var(--accent); margin-bottom: 0.5rem;">01 / GATEWAYS</div>
						<h3 style="font-size: 1.25rem; font-weight: 500; margin-bottom: 0.5rem; color: var(--text-primary);">Email & WhatsApp Dispatch</h3>
						<p style="font-size: 0.85rem; color: var(--text-secondary); line-height: 1.6; font-weight: 300;">Sub-50ms transactional message routing with verified recipient tracking and automated multi-channel fallback.</p>
					</div>
					<div style="border-top: 1px solid var(--border-color); padding-top: 1.5rem;">
						<div class="font-mono" style="font-size: 0.72rem; color: var(--accent); margin-bottom: 0.5rem;">02 / CAMPAIGNS</div>
						<h3 style="font-size: 1.25rem; font-weight: 500; margin-bottom: 0.5rem; color: var(--text-primary);">Synthetic Campaign Engines</h3>
						<p style="font-size: 0.85rem; color: var(--text-secondary); line-height: 1.6; font-weight: 300;">Real-time asset variant generation and predictive copy alignment optimizing conversion funnels autonomously.</p>
					</div>
					<div style="border-top: 1px solid var(--border-color); padding-top: 1.5rem;">
						<div class="font-mono" style="font-size: 0.72rem; color: var(--accent); margin-bottom: 0.5rem;">03 / RETENTION</div>
						<h3 style="font-size: 1.25rem; font-weight: 500; margin-bottom: 0.5rem; color: var(--text-primary);">Behavioral Retention Scoring</h3>
						<p style="font-size: 0.85rem; color: var(--text-secondary); line-height: 1.6; font-weight: 300;">Latent customer propensity analysis detecting churn signals and triggering hyper-personalized re-engagement loops.</p>
					</div>
				</div>
			</section>
		</div>

		<!-- LABS System Characteristics: Local LLM Stack (Visible ONLY in LABS mode) -->
		<div class="brand-show-labs">
			<section id="labs-characteristics" class="specs-section container">
				<div class="section-header">
					<div class="font-mono section-label" style="color: #0df2a5;">TECHNICAL DATA</div>
					<h2 class="section-title">System Characteristics</h2>
					<p class="hero-subtitle" style="margin-top: 1rem; margin-bottom: 0;">
						The open-weight model families we fine-tune, quantize and serve entirely on local infrastructure.
					</p>
				</div>

				<div class="specs-grid specs-grid-4">
					<MetricCard
						label="LABS_MODEL_01"
						value="Qwen"
						title="Instruction & Tool-Use Alignment"
						description="Our primary general-purpose family for agentic tool calling and domain instruction tuning on client corpora."
						status="FINE-TUNED"
					/>
					<MetricCard
						label="LABS_MODEL_02"
						value="DeepSeek"
						title="Reasoning & Code Synthesis"
						description="Used for long-horizon reasoning chains, code generation and structured planning inside agentic workflows."
						status="DEPLOYED"
					/>
					<MetricCard
						label="LABS_MODEL_03"
						value="GLM"
						title="Multilingual Enterprise Dialogue"
						description="Bilingual and multilingual assistants for support, retrieval and document understanding workloads."
						status="TUNING"
					/>
					<MetricCard
						label="LABS_MODEL_04"
						value="Kimi"
						title="Long-Context Document Analysis"
						description="Extended context windows for whole-repository, contract and knowledge-base comprehension tasks."
						status="EVALUATING"
					/>
				</div>
			</section>
		</div>

		<!-- AGENCY System Characteristics: Growth Parameters (Visible ONLY in AGENCY mode) -->
		<div class="brand-show-agency">
			<section id="agency-characteristics" class="specs-section container">
				<div class="section-header">
					<div class="font-mono section-label" style="color: var(--accent);">TECHNICAL DATA</div>
					<h2 class="section-title">System Characteristics</h2>
					<p class="hero-subtitle" style="margin-top: 1rem; margin-bottom: 0;">
						The parameters our growth engines operate on across every campaign and channel.
					</p>
				</div>

				<div class="specs-grid">
					<MetricCard
						label="AGENCY_PARAM_01"
						value="Engagement"
						title="Audience Interaction Loops"
						description="Behavioural signals across Email and WhatsApp journeys driving re-engagement and retention sequencing."
						status="TRACKED"
					/>
					<MetricCard
						label="AGENCY_PARAM_02"
						value="Strategy"
						title="Positioning & Funnel Design"
						description="Offer framing, audience segmentation and channel mix defined before a single creative goes live."
						status="DEFINED"
					/>
					<MetricCard
						label="AGENCY_PARAM_03"
						value="Meta Ads"
						title="Paid Social Operations"
						description="Facebook and Instagram campaign structures, creative variants and audience testing managed end to end."
						status="RUNNING"
					/>
				</div>
			</section>
		</div>

		<!-- Interactive Console Section -->
		<section id="observability" class="console-section container">
			<div class="console-wrapper">
				<div class="console-header">
					<div class="console-dots">
						<span class="dot-red"></span>
						<span class="dot-yellow"></span>
						<span class="dot-green"></span>
					</div>
					<div class="console-title font-mono">system_observability_console.log</div>
					<div class="console-status font-mono">LIVESTREAM</div>
				</div>
				<div class="console-body">
					<div class="console-lines font-mono" id="console-output">
						<!-- JavaScript will inject log streams here -->
					</div>
				</div>
			</div>
		</section>

		<!-- Sub-Brands Showcase Section -->
		<section class="split-brands-section container">
			<div class="split-grid">
				<div class="split-col labs-col">
					<div class="split-bg-effect"></div>
					<div class="col-content">
						<span class="font-mono col-num">01 / RESEARCH</span>
						<h3 class="col-title">Exponential Labs</h3>
						<p class="col-desc">
							Dedicated to deep-tech artificial intelligence research. We design next-generation agent workflows and local model alignment techniques for sovereign infrastructures.
						</p>
						<button class="col-action-btn font-mono" data-trigger-brand="labs">Initialize Labs View</button>
					</div>
				</div>
				<div class="split-col agency-col">
					<div class="split-bg-effect"></div>
					<div class="col-content">
						<span class="font-mono col-num">02 / APPLICATIONS</span>
						<h3 class="col-title">Exponential Marketing Agency</h3>
						<p class="col-desc">
							Focusing on AI-powered brand growth, signal analytics, and creative automation systems that scale conversions while keeping brand aesthetics premium.
						</p>
						<button class="col-action-btn font-mono" data-trigger-brand="agency">Initialize Agency View</button>
					</div>
				</div>
			</div>
		</section>

		<!-- Contact Section -->
		<section id="connect" class="contact-section container">
			<div class="contact-card">
				<div class="contact-grid">
					<div class="contact-info">
						<div class="font-mono contact-meta">LET'S CONNECT?</div>
						<h2 class="contact-title">Ready to Initiate a Conversation?</h2>
						<p class="contact-desc">
							Let's build or scale your exisiting product. Connect with our team.
						</p>
					</div>
					<div class="contact-form-wrapper">
						<form class="contact-form" id="handshake-form">
							<div class="form-group">
								<label class="font-mono" for="email">IDENTITY / EMAIL</label>
								<input type="email" id="email" required placeholder="name@organization.com" />
							</div>
							<div class="form-group">
								<label class="font-mono" for="stack">OBJECTIVE / INTERFACE TYPE</label>
								<select id="stack">
									<option value="Core Neural Infrastructure & Cognitive Cloud">Core: MVP Build</option>
									<option value="Labs: Custom Models & Local Inference">Labs: Custom Model Deployment & Local Inference</option>
									<option value="Agency: Synthetic Engines & Growth Analytics">Agency: Synthetic Engines & Growth Analytics</option>
								</select>
							</div>
							<div class="form-group">
								<label class="font-mono" for="note">BRIEFING PARAMETERS</label>
								<textarea id="note" rows="3" placeholder="Outline model requirements, compliance limits, or creative goals..."></textarea>
							</div>
							<button type="submit" class="btn btn-primary form-submit">
								<span>Request Handshake</span>
								<svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
									<path d="M2.5 9.5L9.5 2.5M9.5 2.5H4M9.5 2.5V8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
								</svg>
							</button>
						</form>
					</div>
				</div>
			</div>
		</section>

		<!-- Footer -->
		<footer class="footer">
			<div class="footer-inner container">
				<div class="footer-brand">
					<h3 class="footer-cta-title"><span class="italic-serif">Exponential Functions</span></h3>
					<p class="footer-brand-tagline">Updates on neural infrastructure, agentic workflows and what's provisioning.</p>
					
					<form class="footer-subscribe-form" id="subscribe-form">
						<input type="email" placeholder="Enter your email" required class="subscribe-input" id="subscribe-email" />
						<button type="submit" class="subscribe-btn">Subscribe</button>
					</form>
				</div>
				
				<div class="footer-links-grid">
					<div class="footer-links-col">
						<span class="font-mono footer-col-title">ABOUT US</span>
					</div>
					<div class="footer-links-col">
						<span class="font-mono footer-col-title">BLOGS</span>
					</div>
				</div>
			</div>
			
			<div class="footer-bottom container">
				<p class="copyright">Exponential Functions &copy; {new Date().getFullYear()}</p>
				
				<div class="footer-socials">
					<a href="#" aria-label="Twitter / X">X</a>
					<a href="#" aria-label="Email">Mail</a>
				</div>
			</div>

			<div class="footer-huge-bg-text">
				EXPONENTIΛL
			</div>
		</footer>
	</main>
</Layout>

<style>
	/* Dynamic brand views display logic */
	.brand-show-core, .brand-show-labs, .brand-show-agency {
		display: none;
	}

	html.brand-core .brand-show-core {
		display: block;
		animation: fadeInBrand 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
	}
	html.brand-labs .brand-show-labs {
		display: block;
		animation: fadeInBrand 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
	}
	html.brand-agency .brand-show-agency {
		display: block;
		animation: fadeInBrand 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
	}

	@keyframes fadeInBrand {
		from {
			opacity: 0;
			transform: translateY(8px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.page-container {
		position: relative;
		min-height: 100vh;
		width: 100%;
		overflow: hidden;
		display: flex;
		flex-direction: column;
	}

	/* Header Styling */
	.header {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 50;
		border-bottom: 1px solid var(--border-color);
		background: color-mix(in srgb, var(--bg-primary) 70%, transparent);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		transition: border-color 0.8s ease, background-color 0.8s ease;
	}

	.header-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		height: 72px;
	}

	.logo {
		font-family: 'Plus Jakarta Sans', sans-serif;
		font-weight: 600;
		font-size: 0.95rem;
		letter-spacing: 0.25em;
		text-decoration: none;
		color: var(--text-primary);
		display: flex;
		align-items: center;
		gap: 12px;
		transition: color 0.8s ease;
	}

	.header-logo-img {
		height: 32px;
		width: auto;
		display: block;
		object-fit: contain;
		filter: drop-shadow(0 0 10px rgba(255, 255, 255, 0.15));
		transition: transform 0.3s ease;
	}

	.logo:hover .header-logo-img {
		transform: scale(1.06);
	}

	.logo-accent {
		color: var(--accent);
		transition: color 0.8s ease;
	}

	.nav-desktop {
		display: flex;
		align-items: center;
		gap: 2rem;
	}

	.nav-link {
		text-decoration: none;
		font-size: 0.8rem;
		font-weight: 500;
		color: var(--text-secondary);
		transition: color 0.3s ease;
		display: flex;
		align-items: center;
		gap: 4px;
	}

	.nav-num {
		color: var(--accent);
		font-size: 0.75rem;
		font-family: 'JetBrains Mono', monospace;
	}

	.nav-link:hover {
		color: var(--text-primary);
	}

	.contact-btn {
		background: var(--text-primary);
		color: var(--bg-primary);
		padding: 6px 14px;
		border-radius: 99px;
		font-weight: 600;
		transition: transform 0.3s ease, background-color 0.8s ease, color 0.8s ease;
	}

	.contact-btn:hover {
		transform: translateY(-1px);
		color: var(--bg-primary);
	}

	.mobile-menu-trigger {
		display: none;
		flex-direction: column;
		justify-content: center;
		gap: 6px;
		width: 30px;
		height: 30px;
		background: transparent;
		border: none;
		cursor: pointer;
		padding: 0;
		z-index: 110;
	}

	.hamburger-line {
		width: 22px;
		height: 1.5px;
		background: var(--text-primary);
		transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), background-color 0.8s ease;
	}

	.mobile-menu-trigger.active .hamburger-line:nth-child(1) {
		transform: translateY(3.75px) rotate(45deg);
	}

	.mobile-menu-trigger.active .hamburger-line:nth-child(2) {
		transform: translateY(-3.75px) rotate(-45deg);
	}

	.mobile-menu-overlay {
		position: fixed;
		inset: 0;
		background: var(--bg-primary);
		z-index: 105;
		display: flex;
		justify-content: center;
		align-items: center;
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1), background-color 0.8s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.mobile-menu-overlay.active {
		opacity: 1;
		pointer-events: auto;
	}

	.mobile-nav {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 2.5rem;
		text-align: center;
		width: 100%;
		padding: 2rem;
	}

	.mobile-nav-link {
		text-decoration: none;
		font-size: 1.5rem;
		font-family: 'Plus Jakarta Sans', sans-serif;
		font-weight: 500;
		color: var(--text-primary);
		display: flex;
		align-items: center;
		gap: 8px;
		transition: transform 0.3s ease, color 0.8s ease;
	}

	.mobile-nav-link:hover {
		transform: translateY(-2px);
	}

	.mobile-contact-btn {
		background: var(--text-primary);
		color: var(--bg-primary);
		padding: 10px 24px;
		border-radius: 99px;
		font-size: 1.1rem;
		font-weight: 600;
		transition: background-color 0.8s ease, color 0.8s ease;
	}

	/* Hero Section */
	.hero-section {
		padding-top: 180px;
		padding-bottom: 100px;
		position: relative;
		z-index: 5;
		display: flex;
		align-items: center;
		min-height: 85vh;
	}

	.hero-content {
		max-width: 850px;
	}

	.hero-meta {
		font-size: 0.8rem;
		color: var(--text-secondary);
		margin-bottom: 1.5rem;
		letter-spacing: 0.15em;
		display: inline-block;
		transition: color 0.8s ease;
	}

	.hero-title {
		font-size: 4.8rem;
		margin-bottom: 2rem;
		color: var(--text-primary);
		transition: color 0.8s ease;
	}

	.italic-serif {
		font-family: 'Instrument Serif', Georgia, serif;
		font-style: italic;
	}

	.hero-subtitle {
		font-size: 1.2rem;
