---
interface Props {
  label: string;
  value: string;
  title: string;
  description: string;
  status?: string;
}

const { label, value, title, description, status = "OPTIMAL" } = Astro.props;
---
<div class="metric-card">
  <div class="card-header">
    <span class="font-mono card-label">{label}</span>
    {status && (
      <div class="status-container">
        <span class="status-pulse"></span>
        <span class="font-mono status-text">{status}</span>
      </div>
    )}
  </div>
  
  <div class="card-value">{value}</div>
  
  <div class="card-details">
    <h3 class="card-title">{title}</h3>
    <p class="card-desc">{description}</p>
  </div>
  
  <!-- Sleek blueprint aesthetic lines -->
  <div class="corner-mark top-left"></div>
  <div class="corner-mark top-right"></div>
  <div class="corner-mark bottom-left"></div>
  <div class="corner-mark bottom-right"></div>
</div>

<style>
  .metric-card {
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    padding: 2.25rem 2rem;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 280px;
    transition: 
      background-color 0.8s cubic-bezier(0.16, 1, 0.3, 1),
      border-color 0.8s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.4s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    cursor: default;
  }
  
  .metric-card:hover {
    transform: translateY(-4px);
    border-color: var(--border-focus);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
  }
  
  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
  }
  
  .card-label {
    color: var(--text-muted);
    font-size: 0.75rem;
  }
  
  .status-container {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  
  .status-pulse {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 8px var(--accent);
    position: relative;
  }
  
  .status-pulse::after {
    content: '';
    position: absolute;
    inset: -3px;
    border: 1px solid var(--accent);
    border-radius: 50%;
    animation: pulse 2s infinite;
  }
  
  .status-text {
    font-size: 0.7rem;
    color: var(--text-secondary);
  }
  
  .card-value {
    font-family: 'Instrument Serif', Georgia, serif;
    font-size: 3.5rem;
    line-height: 1;
    color: var(--text-primary);
    margin-bottom: 1.5rem;
    transition: color 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }
  
  .card-title {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
    letter-spacing: -0.01em;
    transition: color 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }
  
  .card-desc {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.5;
    transition: color 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }
  
  /* Corner markings representing quiet tech luxury details */
  .corner-mark {
    position: absolute;
    width: 6px;
    height: 6px;
    border: 1px solid var(--border-color);
    opacity: 0.5;
    transition: border-color 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }
  
  .metric-card:hover .corner-mark {
    border-color: var(--accent);
    opacity: 1;
  }
  
  .top-left { top: -1px; left: -1px; border-right: 0; border-bottom: 0; }
  .top-right { top: -1px; right: -1px; border-left: 0; border-bottom: 0; }
  .bottom-left { bottom: -1px; left: -1px; border-right: 0; border-top: 0; }
  .bottom-right { bottom: -1px; right: -1px; border-left: 0; border-top: 0; }
  
  @keyframes pulse {
    0% { transform: scale(1); opacity: 1; }
    100% { transform: scale(2.2); opacity: 0; }
  }

  @media (max-width: 480px) {
    .metric-card {
      padding: 1.5rem 1.25rem;
      min-height: 220px;
    }
    .card-value {
      font-size: 2.75rem;
      margin-bottom: 1rem;
    }
    .card-title {
      font-size: 0.95rem;
    }
    .card-desc {
      font-size: 0.8rem;
    }
  }
</style>
