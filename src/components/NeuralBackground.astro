---
// NeuralBackground.astro - Minimalist Modern Ambient Background
---

<div class="background-canvas-container" id="bg-canvas-wrapper">
  <!-- Minimalist Clean Grid -->
  <div class="modern-grid"></div>

  <!-- Soft Ambient Light Diffusion -->
  <div class="ambient-glow" id="ambient-glow-layer"></div>

  <!-- Interactive Smooth Mouse Torch Canvas -->
  <canvas id="particle-canvas" class="particle-canvas"></canvas>
</div>

<style>
  .background-canvas-container {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    z-index: 0;
    pointer-events: none;
  }

  .modern-grid {
    position: absolute;
    inset: 0;
    background-image: 
      linear-gradient(to right, var(--grid-color) 1px, transparent 1px),
      linear-gradient(to bottom, var(--grid-color) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(ellipse at 50% 30%, black 40%, transparent 90%);
    opacity: 0.75;
    z-index: 1;
  }
  
  .ambient-glow {
    position: absolute;
    inset: 0;
    background: var(--radial-gradient);
    z-index: 2;
    transition: background 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .particle-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 3;
    opacity: 0.8;
  }
</style>

<script>
  function initModernCanvas() {
    const canvas = document.getElementById('particle-canvas') as HTMLCanvasElement;
    if (!canvas) return;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let width = (canvas.width = window.innerWidth);
    let height = (canvas.height = window.innerHeight);

    window.addEventListener('resize', () => {
      width = canvas.width = window.innerWidth;
      height = canvas.height = window.innerHeight;
    }, { passive: true });

    let mouseX = width / 2;
    let mouseY = height / 3;
    let targetMouseX = width / 2;
    let targetMouseY = height / 3;

    window.addEventListener('mousemove', (e) => {
      targetMouseX = e.clientX;
      targetMouseY = e.clientY;
    }, { passive: true });

    function getAccentColor(): { main: string; rgb: string } {
      const htmlClass = document.documentElement.className;
      if (htmlClass.includes('brand-labs')) {
        return { main: '#0df2a5', rgb: '13, 242, 165' };
      }
      if (htmlClass.includes('brand-agency')) {
        return { main: '#876534', rgb: '135, 101, 52' };
      }
      return { main: '#38bdf8', rgb: '56, 189, 248' }; // Core default
    }

    // Create 45 ambient neural particles that float continuously
    const numParticles = 45;
    interface Particle {
      x: number;
      y: number;
      vx: number;
      vy: number;
      size: number;
      alpha: number;
      pulseSpeed: number;
    }

    const particles: Particle[] = [];
    for (let i = 0; i < numParticles; i++) {
      particles.push({
        x: Math.random() * width,
        y: Math.random() * height,
        vx: (Math.random() - 0.5) * 0.4,
        vy: (Math.random() - 0.5) * 0.4,
        size: Math.random() * 2 + 1,
        alpha: Math.random() * 0.5 + 0.2,
        pulseSpeed: Math.random() * 0.02 + 0.005
      });
    }

    let time = 0;

    function animate() {
      if (!ctx) return;
      ctx.clearRect(0, 0, width, height);
      time += 0.015;

      // Smooth mouse spring interpolation
      mouseX += (targetMouseX - mouseX) * 0.08;
      mouseY += (targetMouseY - mouseY) * 0.08;

      const theme = getAccentColor();

      // 1. Soft Modern Spotlight Gradient following mouse smoothly
      const gradient = ctx.createRadialGradient(mouseX, mouseY, 0, mouseX, mouseY, 380);
      gradient.addColorStop(0, `rgba(${theme.rgb}, 0.16)`);
      gradient.addColorStop(0.5, `rgba(${theme.rgb}, 0.04)`);
      gradient.addColorStop(1, 'transparent');

      ctx.fillStyle = gradient;
      ctx.beginPath();
      ctx.arc(mouseX, mouseY, 380, 0, Math.PI * 2);
      ctx.fill();

      // 2. Draw & Update ambient floating neural particles
      for (let i = 0; i < particles.length; i++) {
        const p = particles[i];
        p.x += p.vx;
        p.y += p.vy;

        // Wrap boundaries
        if (p.x < 0) p.x = width;
        if (p.x > width) p.x = 0;
        if (p.y < 0) p.y = height;
        if (p.y > height) p.y = 0;

        // Dynamic pulse alpha
        const currentAlpha = p.alpha + Math.sin(time * 2 + i) * 0.15;
        const clampedAlpha = Math.max(0.05, Math.min(0.8, currentAlpha));

        ctx.fillStyle = `rgba(${theme.rgb}, ${clampedAlpha})`;
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
        ctx.fill();

        // Connect nearby particles with subtle neural lines
        for (let j = i + 1; j < particles.length; j++) {
          const p2 = particles[j];
          const dx = p.x - p2.x;
          const dy = p.y - p2.y;
          const dist = Math.sqrt(dx * dx + dy * dy);

          if (dist < 130) {
            const lineAlpha = (1 - dist / 130) * 0.15 * clampedAlpha;
            ctx.strokeStyle = `rgba(${theme.rgb}, ${lineAlpha})`;
            ctx.lineWidth = 0.75;
            ctx.beginPath();
            ctx.moveTo(p.x, p.y);
            ctx.lineTo(p2.x, p2.y);
            ctx.stroke();
          }
        }
      }

      requestAnimationFrame(animate);
    }

    animate();
  }

  initModernCanvas();
</script>
