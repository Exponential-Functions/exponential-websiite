---
// NeuralBackground.astro - Minimalist Modern Ambient Background
---

<div class="background-canvas-container" id="bg-canvas-wrapper">
  <!-- Minimalist Clean Grid -->
  <div class="modern-grid"></div>

  <!-- Soft Ambient Light Diffusion -->
  <div class="ambient-glow" id="ambient-glow-layer"></div>

  <!-- Interactive Smooth Mouse Torch Canvas -->
  <canvas id="particle-canvas" class="particle-canvas"></canvas>
</div>

<style>
  .background-canvas-container {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    z-index: 0;
    pointer-events: none;
  }

  .modern-grid {
    position: absolute;
    inset: 0;
    background-image: 
      linear-gradient(to right, var(--grid-color) 1px, transparent 1px),
      linear-gradient(to bottom, var(--grid-color) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(ellipse at 50% 30%, black 40%, transparent 90%);
    opacity: 0.75;
    z-index: 1;
  }
  
  .ambient-glow {
    position: absolute;
    inset: 0;
    background: var(--radial-gradient);
    z-index: 2;
    transition: background 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .particle-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 3;
    opacity: 0.8;
  }
</style>

<script>
  function initModernCanvas() {
    const canvas = document.getElementById('particle-canvas') as HTMLCanvasElement;
    if (!canvas) return;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let width = (canvas.width = window.innerWidth);
    let height = (canvas.height = window.innerHeight);

    window.addEventListener('resize', () => {
      width = canvas.width = window.innerWidth;
      height = canvas.height = window.innerHeight;
    }, { passive: true });

    let mouseX = width / 2;
    let mouseY = height / 3;
    let targetMouseX = width / 2;
    let targetMouseY = height / 3;

    window.addEventListener('mousemove', (e) => {
      targetMouseX = e.clientX;
      targetMouseY = e.clientY;
    }, { passive: true });

    function getAccentColor(): { main: string; rgb: string } {
      const htmlClass = document.documentElement.className;
      if (htmlClass.includes('brand-labs')) {
        return { main: '#0df2a5', rgb: '13, 242, 165' };
      }
      if (htmlClass.includes('brand-agency')) {
        return { main: '#876534', rgb: '135, 101, 52' };
      }
      return { main: '#38bdf8', rgb: '56, 189, 248' }; // Core default
    }

    function animate() {
      if (!ctx) return;
      ctx.clearRect(0, 0, width, height);

      // Smooth mouse spring interpolation
      mouseX += (targetMouseX - mouseX) * 0.08;
      mouseY += (targetMouseY - mouseY) * 0.08;

      const theme = getAccentColor();

      // Soft Modern Spotlight Gradient following mouse smoothly
      const gradient = ctx.createRadialGradient(mouseX, mouseY, 0, mouseX, mouseY, 320);
      gradient.addColorStop(0, `rgba(${theme.rgb}, 0.14)`);
      gradient.addColorStop(0.4, `rgba(${theme.rgb}, 0.04)`);
      gradient.addColorStop(1, 'transparent');

      ctx.fillStyle = gradient;
      ctx.beginPath();
      ctx.arc(mouseX, mouseY, 320, 0, Math.PI * 2);
      ctx.fill();

      requestAnimationFrame(animate);
    }

    animate();
  }

  initModernCanvas();
</script>
