        cellValues: ['11010011', '01001100', '10101111', '00110001', '11100011', '01110010']
      },
      lora: {
        label: 'TENSOR WEIGHT MATRIX [LoRA ΔW RANK-16]',
        density: 'COMPRESSION RATIO: 64.0x',
        block: 'Rank-16 Matrix',
        error: '0.00% (EXACT)',
        throughput: '310 tokens/sec',
