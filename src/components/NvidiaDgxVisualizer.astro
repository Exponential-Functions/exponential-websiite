        cellValues: ['32b', '32b', '32b', '32b', '32b', '32b']
      }
    };

    function renderMatrix(modeKey: string) {
      const data = modes[modeKey];
      if (!data) return;

      if (modeLabel) modeLabel.textContent = data.label;
      if (densityLabel) densityLabel.textContent = data.density;
      if (valBlock) valBlock.textContent = data.block;
      if (valError) valError.textContent = data.error;
      if (valThroughput) valThroughput.textContent = data.throughput;
      if (valVram) valVram.textContent = data.vram;
      if (valBandwidth) valBandwidth.textContent = data.bandwidth;

      if (barThroughput) barThroughput.style.width = data.throughputPct;
      if (barVram) barVram.style.width = data.vramPct;

      // Defensive null checks for TypeScript safety
      const targetGrid = document.getElementById('weight-grid');
      if (!targetGrid) return;

      targetGrid.innerHTML = '';
      for (let i = 0; i < 36; i++) {
        const cell = document.createElement('div');
        cell.className = 'cell-weight';
        const colorIdx = i % data.cellColors.length;
        const valIdx = i % data.cellValues.length;
        cell.style.backgroundColor = data.cellColors[colorIdx];
        cell.textContent = data.cellValues[valIdx];
        targetGrid.appendChild(cell);
      }
    }

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        tabs.forEach(t => t.classList.remove('active'));
        tab.classList.add('active');
        const mode = tab.getAttribute('data-mode');
        if (mode) renderMatrix(mode);
      });
    });

    // Default init
    renderMatrix('fp4');
  }

  // Initialize on load
  initTensorInspector();
</script>
