        cellValues: ['ΔW1', 'ΔW2', 'ΔW3', 'ΔW4', 'ΔW5', 'ΔW6']
      },
      fp32: {
        label: 'TENSOR WEIGHT MATRIX [FP32 UNCOMPRESSED]',
        density: 'COMPRESSION RATIO: 1.0x',
        block: 'Uncompressed',
